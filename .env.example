# NovelGenerator Configuration
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
NOVELS_DIR=./novels
HOST=0.0.0.0
PORT=8000
# 同源部署可留空；跨域开发时填写逗号分隔的明确来源，禁止生产使用 *
CORS_ORIGINS=
ALLOW_WILDCARD_CORS=false
AUTH_RATE_LIMIT=10
# WeChat Mini Program production login; leave unset until the official app is registered.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_SESSION_SECRET=
WECHAT_SESSION_TTL_SECONDS=604800

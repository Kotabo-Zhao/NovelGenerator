page {
  background: #f6f3ec;
  color: #23201a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 56rpx;
}

.page-header {
  margin-bottom: 36rpx;
}

.eyebrow {
  color: #a8843c;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.page-title {
  color: #23201a;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.page-subtitle {
  color: #7c7566;
  font-size: 25rpx;
  margin-top: 6rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e0dacb;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(35, 32, 26, .04);
  padding: 28rpx;
}

.section-title {
  color: #23201a;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.muted {
  color: #7c7566;
}

.hint {
  color: #a59c8b;
  font-size: 23rpx;
}

.primary-button,
.secondary-button,
.quiet-button {
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  text-align: center;
}

.primary-button {
  background: #c0392b;
  color: #ffffff;
}

.secondary-button {
  background: #ffffff;
  border: 1rpx solid #c0392b;
  color: #c0392b;
}

.quiet-button {
  background: #efebe1;
  color: #5d5548;
}

button[disabled] {
  background: #d9d3c7;
  color: #ffffff;
}

.error-box {
  background: #fff3f0;
  border: 1rpx solid #e6b5ac;
  border-radius: 12rpx;
  color: #a52d22;
  font-size: 24rpx;
  margin-bottom: 24rpx;
  padding: 20rpx;
}

.empty-state {
  align-items: center;
  display: flex;
  flex-direction: column;
  padding: 86rpx 32rpx;
  text-align: center;
}

.empty-mark {
  align-items: center;
  background: #efebe1;
  border-radius: 50%;
  color: #a8843c;
  display: flex;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 48rpx;
  height: 112rpx;
  justify-content: center;
  margin-bottom: 24rpx;
  width: 112rpx;
}

.empty-title {
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.empty-copy {
  color: #7c7566;
  font-size: 24rpx;
  margin-bottom: 28rpx;
}

.form-label {
  color: #5d5548;
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.field {
  background: #faf8f2;
  border: 1rpx solid #e0dacb;
  border-radius: 10rpx;
  color: #23201a;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  min-height: 84rpx;
  padding: 20rpx;
  width: 100%;
}

.textarea-field {
  min-height: 220rpx;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.choice {
  background: #faf8f2;
  border: 1rpx solid #e0dacb;
  border-radius: 999rpx;
  color: #7c7566;
  font-size: 24rpx;
  padding: 12rpx 22rpx;
}

.choice-active {
  background: #fff0ed;
  border-color: #c0392b;
  color: #a52d22;
}

.stack > view,
.stack > button {
  margin-bottom: 20rpx;
}

.row {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.gap-16 {
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
}

.book-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.book-card {
  padding: 26rpx;
}

.book-title {
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.book-meta {
  color: #7c7566;
  font-size: 23rpx;
}

.progress-track {
  background: #efebe1;
  border-radius: 999rpx;
  height: 10rpx;
  margin-top: 18rpx;
  overflow: hidden;
}

.progress-value {
  background: #c0392b;
  border-radius: 999rpx;
  height: 100%;
}

.step-row {
  display: flex;
  margin-bottom: 30rpx;
}

.step {
  color: #a59c8b;
  flex: 1;
  font-size: 23rpx;
  text-align: center;
}

.step-active {
  color: #c0392b;
  font-weight: 700;
}

.notice {
  background: #fffaf0;
  border-left: 6rpx solid #a8843c;
  color: #6f6046;
  font-size: 24rpx;
  margin-bottom: 26rpx;
  padding: 18rpx 22rpx;
}

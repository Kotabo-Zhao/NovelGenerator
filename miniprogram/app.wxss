page {
  background: #f6f3ec;
  color: #23201a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 100%;
}

view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

button {
  margin: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
}

.page-header {
  margin-bottom: 28rpx;
}

.eyebrow {
  color: #a8843c;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.page-title {
  color: #23201a;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.25;
}

.page-subtitle {
  color: #7c7566;
  font-size: 25rpx;
  margin-top: 6rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e0dacb;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 12rpx rgba(35, 32, 26, .04);
  padding: 28rpx;
}

.card-quiet {
  background: rgba(255, 255, 255, .62);
  box-shadow: none;
}

.section-title {
  color: #23201a;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.muted {
  color: #7c7566;
}

.hint {
  color: #a59c8b;
  font-size: 23rpx;
}

.primary-button,
.secondary-button,
.quiet-button {
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  text-align: center;
}

.primary-button[loading] {
  opacity: .78;
}

.button-small {
  font-size: 24rpx;
  line-height: 68rpx;
  min-height: 68rpx;
  padding: 0 22rpx;
}

.button-compact {
  display: inline-block;
  font-size: 25rpx;
  line-height: 72rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
}

.primary-button {
  background: #c0392b;
  color: #ffffff;
}

.secondary-button {
  background: #ffffff;
  border: 1rpx solid #c0392b;
  color: #c0392b;
}

.quiet-button {
  background: #efebe1;
  color: #5d5548;
}

button[disabled] {
  background: #d9d3c7;
  color: #ffffff;
}

.error-box {
  background: #fff3f0;
  border: 1rpx solid #e6b5ac;
  border-radius: 12rpx;
  color: #a52d22;
  font-size: 24rpx;
  margin-bottom: 24rpx;
  padding: 20rpx;
}

.error-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.empty-state {
  align-items: center;
  display: flex;
  flex-direction: column;
  padding: 86rpx 32rpx;
  text-align: center;
}

.empty-mark {
  align-items: center;
  background: #efebe1;
  border-radius: 50%;
  color: #a8843c;
  display: flex;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 48rpx;
  height: 112rpx;
  justify-content: center;
  margin-bottom: 24rpx;
  width: 112rpx;
}

.empty-title {
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.empty-copy {
  color: #7c7566;
  font-size: 24rpx;
  margin-bottom: 28rpx;
}

.empty-state .primary-button {
  min-width: 300rpx;
}

.form-label {
  color: #5d5548;
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.field {
  background: #faf8f2;
  border: 1rpx solid #e0dacb;
  border-radius: 10rpx;
  color: #23201a;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  min-height: 84rpx;
  padding: 20rpx;
  width: 100%;
}

.textarea-field {
  min-height: 220rpx;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.choice {
  background: #faf8f2;
  border: 1rpx solid #e0dacb;
  border-radius: 999rpx;
  color: #7c7566;
  font-size: 24rpx;
  padding: 12rpx 22rpx;
}

.choice-active {
  background: #fff0ed;
  border-color: #c0392b;
  color: #a52d22;
}

.choice-hint {
  color: #a59c8b;
  font-size: 22rpx;
  margin: -12rpx 0 16rpx;
}

.stack > view,
.stack > button {
  margin-bottom: 20rpx;
}

.row {
  align-items: center;
  display: flex;
  justify-content: space-between;
  min-width: 0;
}

.gap-16 {
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
}

.book-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.section-heading {
  align-items: baseline;
  display: flex;
  justify-content: space-between;
  margin: 30rpx 4rpx 16rpx;
}

.section-heading .section-title {
  margin-bottom: 0;
}

.hero-card {
  background: #2d2a25;
  border-radius: 16rpx;
  color: #fffaf0;
  margin-bottom: 26rpx;
  overflow: hidden;
  padding: 30rpx;
  position: relative;
}

.hero-card::after {
  border: 1rpx solid rgba(255, 250, 240, .16);
  border-radius: 50%;
  content: "";
  height: 220rpx;
  position: absolute;
  right: -86rpx;
  top: -94rpx;
  width: 220rpx;
}

.hero-title {
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero-copy {
  color: rgba(255, 250, 240, .72);
  font-size: 24rpx;
  margin-bottom: 24rpx;
  max-width: 560rpx;
}

.hero-card .primary-button {
  background: #d25a47;
  display: inline-block;
  position: relative;
  z-index: 1;
}

.count-badge,
.status-badge {
  background: #efebe1;
  border-radius: 999rpx;
  color: #7c7566;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
}

.status-badge {
  background: #fff0ed;
  color: #a52d22;
}

.metric-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.metric {
  background: #faf8f2;
  border: 1rpx solid #ece7da;
  border-radius: 10rpx;
  flex: 1;
  padding: 16rpx;
}

.metric-value {
  color: #23201a;
  font-size: 32rpx;
  font-weight: 700;
}

.metric-label {
  color: #a59c8b;
  font-size: 21rpx;
}

.book-card {
  padding: 24rpx;
}

.book-card:active {
  background: #fffaf0;
}

.book-main {
  align-items: flex-start;
  display: flex;
  gap: 20rpx;
}

.book-cover {
  align-items: center;
  background: #2d2a25;
  border-radius: 8rpx;
  color: #fffaf0;
  display: flex;
  flex: 0 0 76rpx;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 36rpx;
  height: 96rpx;
  justify-content: center;
}

.book-info {
  flex: 1;
  min-width: 0;
}

.book-title-line {
  align-items: center;
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
  min-width: 0;
}

.book-title-line .book-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-title {
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.book-meta {
  color: #7c7566;
  font-size: 23rpx;
}

.progress-track {
  background: #efebe1;
  border-radius: 999rpx;
  height: 10rpx;
  margin-top: 18rpx;
  overflow: hidden;
}

.progress-value {
  background: #c0392b;
  border-radius: 999rpx;
  height: 100%;
}

.step-row {
  display: flex;
  margin-bottom: 30rpx;
}

.step {
  color: #a59c8b;
  flex: 1;
  font-size: 23rpx;
  text-align: center;
}

.step-active {
  color: #c0392b;
  font-weight: 700;
}

.step-line {
  background: #e0dacb;
  flex: 1;
  height: 2rpx;
  margin: 18rpx 12rpx 0;
}

.step-line-active {
  background: #c0392b;
}

.notice {
  background: #fffaf0;
  border-left: 6rpx solid #a8843c;
  color: #6f6046;
  font-size: 24rpx;
  margin-bottom: 26rpx;
  padding: 18rpx 22rpx;
}

.summary-label {
  color: #7c7566;
  display: block;
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.summary-value {
  color: #23201a;
  font-size: 27rpx;
  word-break: break-all;
}

.skeleton {
  background: linear-gradient(90deg, #efebe1 25%, #f8f5ed 50%, #efebe1 75%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  height: 30rpx;
  margin-bottom: 18rpx;
}

.skeleton-wide {
  height: 40rpx;
  width: 72%;
}

.skeleton-short {
  width: 42%;
}

.sticky-actions {
  background: rgba(246, 243, 236, .94);
  bottom: 0;
  display: flex;
  gap: 16rpx;
  margin: 24rpx -32rpx calc(-72rpx - env(safe-area-inset-bottom));
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  position: sticky;
  z-index: 3;
}

.sticky-actions button {
  flex: 1;
}

.status-line {
  align-items: center;
  border-bottom: 1rpx solid #ece7da;
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
}

.status-line:last-child {
  border-bottom: 0;
}

.progress-card {
  margin-bottom: 20rpx;
}

.chapter-card {
  margin-top: 20rpx;
}

.chapter-toolbar {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-top: 26rpx;
}

.chapter-current {
  text-align: center;
}

.chapter-current .section-title {
  margin-bottom: 0;
}

.task-card {
  margin-top: 20rpx;
}

.task-card .quiet-button {
  margin-top: 16rpx;
}

.chapter-content {
  color: #342e25;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 32rpx;
  line-height: 2;
  white-space: pre-wrap;
}

.compact-empty {
  padding: 50rpx 24rpx;
}

.empty-actions {
  width: 100%;
}

.chapter-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.chapter-actions button {
  font-size: 23rpx;
  padding: 0 8rpx;
}

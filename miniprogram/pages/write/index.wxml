<view class="page">
  <view wx:if="{{!novelId}}" class="card empty-state">
    <view class="empty-mark">写</view>
    <view class="empty-title">先选择一本作品</view>
    <view class="empty-copy">从书架进入，或先创建一本新小说。</view>
    <view class="row gap-16 empty-actions">
      <button class="quiet-button flex-1" bindtap="openShelf">回书架</button>
      <button class="primary-button flex-1" bindtap="openCreate">去创建</button>
    </view>
  </view>

  <block wx:else>
    <view class="page-header">
      <view class="row">
        <view>
          <view class="eyebrow">CURRENT WORK</view>
          <view class="page-title">{{novel.title || novelId}}</view>
        </view>
        <view class="count-badge">{{chapter}} / {{totalChapters || '—'}}</view>
      </view>
      <view class="page-subtitle">专注读完这一章，再决定下一步。</view>
    </view>

    <view wx:if="{{error}}" class="error-box">
      <view>{{error}}</view>
      <view class="error-actions">
        <button class="quiet-button button-small" bindtap="retryCurrent">重新加载</button>
        <button wx:if="{{jobStatus === 'failed' || jobStatus === 'cancelled'}}" class="secondary-button button-small" bindtap="startGeneration">重试生成</button>
      </view>
    </view>

    <view wx:if="{{loading}}" class="card progress-card" aria-busy="true">
      <view class="skeleton skeleton-wide"></view>
      <view class="skeleton skeleton-short"></view>
      <view class="skeleton"></view>
    </view>

    <view wx:if="{{novel && !loading}}" class="card progress-card">
      <view class="row"><text class="section-title">写作进度</text><text class="hint">{{jobStatusText || '可以继续'}}</text></view>
      <view class="metric-row">
        <view class="metric"><view class="metric-value">{{completedChapters}}</view><view class="metric-label">已完成章节</view></view>
        <view class="metric"><view class="metric-value">{{totalChapters || '—'}}</view><view class="metric-label">计划章节</view></view>
      </view>
      <view class="progress-track"><view class="progress-value" style="width: {{novelProgress}}%;"></view></view>
    </view>

    <view wx:if="{{jobId && jobStatus}}" class="card task-card">
      <view class="row"><text class="section-title">生成任务</text><text class="status-badge">{{jobStatusText}}</text></view>
      <view class="progress-track"><view class="progress-value" style="width: {{jobProgress}}%;"></view></view>
      <view class="book-meta">{{jobProgress}}% · 离开页面后回来会继续查询</view>
      <button wx:if="{{jobStatus === 'queued' || jobStatus === 'running'}}" class="quiet-button" bindtap="cancelGeneration">取消任务</button>
    </view>

    <view class="chapter-toolbar">
      <button class="quiet-button button-small" disabled="{{chapter <= 1 || readingLoading}}" bindtap="previousChapter">上一章</button>
      <view class="chapter-current"><view class="section-title">第 {{chapter}} 章</view><view class="hint">{{readingLoading ? '正在读取…' : (content ? '阅读模式' : '等待生成')}}</view></view>
      <button class="quiet-button button-small" disabled="{{!canNext || readingLoading}}" bindtap="nextChapter">下一章</button>
    </view>

    <view wx:if="{{readingLoading}}" class="card chapter-card" aria-busy="true">
      <view wx:for="{{chapterSkeletons}}" wx:key="*this" class="skeleton {{item === 1 ? 'skeleton-wide' : ''}}"></view>
    </view>
    <view wx:elif="{{content && !editing}}" class="card chapter-card">
      <text class="chapter-content">{{content}}</text>
      <view class="chapter-reading-meta">已读 {{contentOffset}} / {{totalContent}} 字</view>
      <button wx:if="{{hasMoreContent}}" class="quiet-button more-content-button" bindtap="loadMoreContent">继续阅读</button>
      <view class="chapter-actions">
        <button class="quiet-button button-small" bindtap="openDraftEditor">编辑草稿</button>
      </view>
    </view>
    <view wx:elif="{{editing}}" class="card chapter-card">
      <textarea class="draft-editor" value="{{draftContent}}" maxlength="50000" auto-height="true" bindinput="onDraftInput" placeholder="在这里修改本章草稿，保存后不会直接覆盖已发布正文。"></textarea>
      <view class="chapter-actions">
        <button class="quiet-button button-small" bindtap="closeDraftEditor">取消</button>
        <button class="primary-button button-small" loading="{{draftSaving}}" disabled="{{draftSaving}}" bindtap="saveDraft">保存草稿</button>
      </view>
    </view>
    <view wx:elif="{{!loading}}" class="card empty-state compact-empty">
      <view class="empty-title">这一章还没有正文</view>
      <view class="empty-copy">确认大纲后，点击下方主按钮生成第 {{chapter}} 章。</view>
      <button class="quiet-button button-small" bindtap="retryChapter">重新读取</button>
    </view>

    <view class="sticky-actions">
      <button class="quiet-button" bindtap="openShelf">回书架</button>
      <button class="primary-button" disabled="{{jobStatus === 'queued' || jobStatus === 'running' || readingLoading}}" bindtap="startGeneration">{{jobStatus === 'queued' || jobStatus === 'running' ? '生成中…' : '生成本章'}}</button>
    </view>
  </block>
</view>

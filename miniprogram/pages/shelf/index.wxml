<view class="page">
  <view class="page-header">
    <view class="eyebrow">NOVEL GENERATOR</view>
    <view class="page-title">书架</view>
    <view class="page-subtitle">把灵感留在这里，慢慢写成一本书。</view>
  </view>

  <view wx:if="{{error}}" class="error-box">{{error}}</view>

  <view wx:if="{{!loading && novels.length === 0}}" class="card empty-state">
    <view class="empty-mark">卷</view>
    <view class="empty-title">还没有作品</view>
    <view class="empty-copy">从一句灵感开始，先确认大纲，再写第一章。</view>
    <button class="primary-button" bindtap="goCreate">创建第一本小说</button>
  </view>

  <view wx:if="{{loading}}" class="card empty-state">
    <view class="empty-title">正在整理书架</view>
    <view class="empty-copy">只加载作品摘要，不拉取整本正文。</view>
  </view>

  <view wx:if="{{novels.length > 0}}" class="book-list">
    <view wx:for="{{novels}}" wx:key="id" class="card book-card" data-id="{{item.id}}" bindtap="openNovel">
      <view class="row">
        <view class="book-title">{{item.title || item.id}}</view>
        <view class="hint">进入写作</view>
      </view>
      <view class="book-meta">{{item.genre || "未分类"}} · {{item.style || "默认风格"}}</view>
      <view class="book-meta">已完成 {{item.disk_chapters || 0}} 章</view>
      <view class="progress-track">
        <view class="progress-value" style="width: {{item.state && item.state.total_chapters ? (item.disk_chapters / item.state.total_chapters * 100) : 0}}%;"></view>
      </view>
    </view>
  </view>
</view>

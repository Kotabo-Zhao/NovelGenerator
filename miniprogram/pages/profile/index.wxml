<view class="page">
  <view class="page-header">
    <view class="eyebrow">YOUR WORKSPACE</view>
    <view class="page-title">我的</view>
    <view class="page-subtitle">把复杂设置收起来，让写作保持专注。</view>
  </view>

  <view class="card auth-card">
    <view class="auth-heading">
      <view class="auth-mark">{{loggedIn ? '✓' : '我'}}</view>
      <view class="auth-copy">
        <view class="section-title">{{loggedIn ? '微信账号已连接' : '登录后开始写作'}}</view>
        <view class="muted">{{loggedIn ? '会话只保存在当前运行内存中。' : '登录后才能访问自己的作品和生成任务。'}}</view>
      </view>
    </view>
    <view wx:if="{{authError}}" class="error-box">{{authError}}</view>
    <button wx:if="{{!loggedIn}}" class="primary-button auth-action" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="login">{{loggingIn ? '正在连接…' : '微信登录'}}</button>
    <button wx:else class="quiet-button auth-action" bindtap="logout">退出当前账号</button>
  </view>

  <view wx:if="{{loggedIn && consentRequired}}" class="card privacy-card">
    <view class="section-title">先确认隐私政策</view>
    <view class="muted privacy-copy">我们会用微信身份保护你的作品，并保存生成任务状态。当前政策版本：{{privacyVersion}}。</view>
    <button class="primary-button" bindtap="agreePrivacy">同意并继续</button>
  </view>

  <view class="card quick-card">
    <view class="section-title">快速入口</view>
    <view class="quick-actions">
      <button class="secondary-button" bindtap="goShelf">我的书架</button>
      <button class="secondary-button" bindtap="goCreate">创建作品</button>
    </view>
  </view>

  <view wx:if="{{loggedIn}}" class="card danger-card">
    <view class="section-title">账号数据</view>
    <view class="muted">注销会删除作品、任务记录和导出文件。</view>
    <button class="danger-button" loading="{{deleting}}" disabled="{{deleting}}" bindtap="deleteAccount">注销账号</button>
  </view>

  <view class="card status-card">
    <view class="section-title">当前能力</view>
    <view class="status-line"><text>作品隔离</text><text class="status-ok">已接入</text></view>
    <view class="status-line"><text>生成任务恢复</text><text class="status-ok">已接入</text></view>
    <view class="status-line"><text>隐私同意与注销</text><text class="status-ok">已接入</text></view>
    <view class="status-line"><text>异步导出</text><text class="status-ok">已接入</text></view>
  </view>

  <view wx:if="{{usage}}" class="card usage-card">
    <view class="section-title">本日用量</view>
    <view class="status-line"><text>已预占 token</text><text>{{usage.tokens_reserved}}</text></view>
    <view class="status-line"><text>模型实际 token</text><text>{{usage.tokens_actual}}</text></view>
    <view class="status-line"><text>估算费用（微单位）</text><text>{{usage.cost_micros}}</text></view>
  </view>

  <view class="notice profile-note">当前版本只保留已经可用的入口。导出任务可从后端查询并下载；语音、分享等高级能力继续放在工具箱，避免打断写作主流程。</view>
</view>

<view class="page">
  <view class="page-header">
    <view class="eyebrow">YOUR WORKSPACE</view>
    <view class="page-title">我的</view>
    <view class="page-subtitle">把复杂设置收起来，让写作保持专注。</view>
  </view>

  <view class="card auth-card">
    <view class="auth-heading">
      <view class="auth-mark">{{loggedIn ? '✓' : '我'}}</view>
      <view class="auth-copy">
        <view class="section-title">{{loggedIn ? '微信账号已连接' : '登录后开始写作'}}</view>
        <view class="muted">{{loggedIn ? '会话只保存在当前运行内存中。' : '登录后才能访问自己的作品和生成任务。'}}</view>
      </view>
    </view>
    <view wx:if="{{authError}}" class="error-box">{{authError}}</view>
    <button wx:if="{{!loggedIn}}" class="primary-button auth-action" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="login">{{loggingIn ? '正在连接…' : '微信登录'}}</button>
    <button wx:else class="quiet-button auth-action" bindtap="logout">退出当前账号</button>
  </view>

  <view class="card quick-card">
    <view class="section-title">快速入口</view>
    <view class="quick-actions">
      <button class="secondary-button" bindtap="goShelf">我的书架</button>
      <button class="secondary-button" bindtap="goCreate">创建作品</button>
    </view>
  </view>

  <view class="card status-card">
    <view class="section-title">当前能力</view>
    <view class="status-line"><text>作品隔离</text><text class="status-ok">已接入</text></view>
    <view class="status-line"><text>生成任务恢复</text><text class="status-ok">已接入</text></view>
    <view class="status-line"><text>隐私同意与注销</text><text class="status-pending">上线前配置</text></view>
    <view class="status-line"><text>导出与分享</text><text class="status-pending">后续开放</text></view>
  </view>

  <view class="notice profile-note">当前版本只保留已经可用的入口。隐私、导出和语音能力完成后，会在这里统一出现，不在写作页重复堆叠开关。</view>
</view>

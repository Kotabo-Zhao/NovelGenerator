<view class="page">
  <view class="page-header">
    <view class="eyebrow">YOUR WORKSPACE</view>
    <view class="page-title">我的</view>
    <view class="page-subtitle">把复杂设置收起来，让写作保持专注。</view>
  </view>

  <view class="card auth-card">
    <view class="row">
      <view>
        <view class="section-title">{{loggedIn ? '已连接微信账号' : '登录后开始写作'}}</view>
        <view class="muted">{{loggedIn ? '会话只保存在当前运行内存中。' : '登录后才能访问自己的作品和生成任务。'}}</view>
      </view>
      <button wx:if="{{!loggedIn}}" class="primary-button auth-button" bindtap="login">微信登录</button>
      <button wx:else class="quiet-button auth-button" bindtap="logout">退出</button>
    </view>
    <view wx:if="{{authError}}" class="error-box">{{authError}}</view>
  </view>

  <view class="card profile-note">
    <view class="section-title">小程序 MVP</view>
    <view class="muted">作品和生成任务已经切换到认证 v1 接口；隐私同意、额度和注销仍需上线配置后开放。</view>
  </view>

  <view class="settings-list">
    <view wx:for="{{items}}" wx:key="key" class="card setting-item" data-key="{{item.key}}" bindtap="onTap">
      <view class="row">
        <view class="setting-title">{{item.title}}</view>
        <view class="hint">›</view>
      </view>
      <view class="book-meta">{{item.desc}}</view>
    </view>
  </view>
</view>

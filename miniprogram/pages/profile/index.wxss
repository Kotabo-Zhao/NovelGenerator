.profile-note {
  border-left: 6rpx solid #a8843c;
  margin-bottom: 24rpx;
}

.auth-card {
  margin-bottom: 20rpx;
}

.auth-button {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 18rpx;
}

.settings-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.setting-item {
  padding: 24rpx 28rpx;
}

.setting-title {
  font-size: 29rpx;
  font-weight: 600;
}

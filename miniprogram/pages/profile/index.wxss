.auth-card,
.quick-card,
.status-card {
  margin-bottom: 20rpx;
}

.auth-heading {
  align-items: center;
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.auth-mark {
  align-items: center;
  background: #2d2a25;
  border-radius: 50%;
  color: #fffaf0;
  display: flex;
  flex: 0 0 72rpx;
  font-size: 32rpx;
  height: 72rpx;
  justify-content: center;
}

.auth-copy {
  flex: 1;
  min-width: 0;
}

.auth-copy .section-title {
  margin-bottom: 4rpx;
}

.auth-action {
  width: 100%;
}

.quick-actions {
  display: flex;
  gap: 16rpx;
}

.quick-actions button {
  flex: 1;
  font-size: 25rpx;
  line-height: 76rpx;
  min-height: 76rpx;
}

.status-ok {
  color: #3d7962;
  font-size: 23rpx;
}

.status-pending {
  color: #a8843c;
  font-size: 23rpx;
}

.profile-note {
  display: block;
  margin-top: 4rpx;
}

.privacy-card,
.danger-card {
  margin-bottom: 20rpx;
}

.privacy-copy {
  line-height: 1.7;
  margin: 12rpx 0 20rpx;
}

.danger-button {
  background: #fff0ed;
  border: 1rpx solid #e4a59b;
  color: #b6382b;
  margin-top: 18rpx;
  width: 100%;
}
